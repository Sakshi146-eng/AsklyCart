# CommerceOps — Environment Variables
# Copy this to .env and fill in your values

# ── Groq LLM ─────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_A=qwen/qwen3.8-27b
GROQ_MODEL_B=openai/gpt-oss-120b

# ── Google Gemini (embeddings) ────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ── Razorpay (test mode) ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-signing-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Email (SMTP — Gmail App Password) ────────────────────────
# Enable 2FA on Gmail, then generate an App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
EMAIL_FROM=CommerceOps <your.gmail@gmail.com>

# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://commerceops:commerceops@postgres:5432/commerceops

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_RETRY_QUEUE=payment_retry

# ── Qdrant ────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=products

# ── Business Rules ────────────────────────────────────────────
DEFAULT_SPENDING_CAP=2000.0
MAX_RETRY_ATTEMPTS=2

# ── Debug ─────────────────────────────────────────────────────
# Set to True to force payment failures (for Gate 3 / retry demo)
FORCE_PAYMENT_FAIL=False
APP_ENV=development
DEBUG=True
